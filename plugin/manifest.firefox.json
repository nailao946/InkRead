{
  "manifest_version": 3,
  "name": "InkRead 墨读 — 视频与文章生词量",
  "version": "1.5.0",
  "description": "识别哔哩哔哩 / YouTube 视频与网页文章的生词量：联动墨读词库给出 L1–L4 / CEFR / 蓝思三套评级；字幕与正文逐词上色、点词查离线释义与在线翻译，支持 2.4 万条常用词组。",
  "browser_specific_settings": {
    "gecko": {
      "id": "inkread-video@inkread.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.hdslb.com/*",
    "*://*.youtube.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": [
      "src/background/sw.js"
    ],
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "InkRead 墨读 — 分析当前页面",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/article.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
