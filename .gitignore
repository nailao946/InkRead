# ---------- 构建产物 ----------
wpf/bin/
wpf/obj/
tools/server-smoke/bin/
tools/server-smoke/obj/
**/*.dll
**/*.pdb
!web/lib/*.js

# ---------- 运行时日志 ----------
*.log
InkRead.log
**/InkRead.log

# ---------- 测试临时文件 ----------
web/tests/edge-prof-*/
web/tests/*.txt
web/tests/v-*.png
web/tests/_*.mjs
web/tests/_store-backup-*/
web/tests/_store-sandbox*/
web/tools/__pycache__/
**/__pycache__/
tools/store-test/

# ---------- 浏览器扩展（plugin/）----------
# dist/：node plugin/build.mjs 生成的打包产物
plugin/dist/
# 词频语料下载缓存（tools/make-freq.mjs 用，可重新拉取）
plugin/tools/_cache/
# E2E 临时浏览器配置目录
plugin/tests/_e2e-*/

# ---------- 词典 / 词组数据源缓存（可脚本重新下载，不入库） ----------
web/tools/cache/
web/tools/_analyze_phrases*.py

# ---------- 编辑器 / IDE ----------
.vs/
.vscode/
.idea/
*.user
*.suo

# ---------- 本地记忆（不随仓库分发） ----------
.workbuddy/

# ---------- 真实电子书（版权）：保留 tests/samples 下的小样本 ----------
*.mobi
*.azw3
*.azw
*.prc
*.epub
*.pdf
!web/tests/samples/*.mobi
!web/tests/samples/*.epub
