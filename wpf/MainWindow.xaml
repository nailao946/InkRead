<Window x:Class="InkRead.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="墨读 InkRead"
        Width="1220" Height="820"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1C"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif">

    <!-- 无系统标题栏：自绘一条与 web 端同色系的标题栏（深纸色 + 金色点缀） -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 标题栏按钮（最小化 / 最大化） -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#B4B0A8" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3B3B37" />
                                <Setter Property="Foreground" Value="#F3F0E8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 关闭按钮：悬停变红 -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C4442F" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="rootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏 -->
        <Border Grid.Row="0" Background="#2C2C2A" BorderBrush="#3A3A37" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="21" Height="21" CornerRadius="6" Background="#FAC775" Margin="0,0,10,0">
                        <TextBlock Text="墨" Foreground="#2C2C2A" FontSize="11.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="墨读" Foreground="#F2EFE7" FontSize="13.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="InkRead" Foreground="#8A8781" FontSize="11.5" Margin="7,1,0,0"
                               VerticalAlignment="Center" />
                    <Border Background="#333330" CornerRadius="99" Padding="9,2.5" Margin="16,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="statusText" Text="正在启动…" Foreground="#9C988F" FontSize="11" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="btnMin" Style="{StaticResource CaptionButton}" Click="btnMin_Click" ToolTip="最小化">
                        <TextBlock Text="&#x2013;" FontSize="13" />
                    </Button>
                    <Button x:Name="btnMax" Style="{StaticResource CaptionButton}" Click="btnMax_Click" ToolTip="最大化 / 还原">
                        <TextBlock x:Name="maxGlyph" Text="&#x25A1;" FontSize="12" />
                    </Button>
                    <Button x:Name="btnClose" Style="{StaticResource CloseButton}" Click="btnClose_Click" ToolTip="关闭">
                        <TextBlock Text="&#x2715;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区：WebView2（前端界面） -->
        <wv:WebView2 x:Name="webView" Grid.Row="1"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    </Grid>
</Window>
